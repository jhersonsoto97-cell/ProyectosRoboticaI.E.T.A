# Salida de compilacion de ESP-IDF.
build/

# sdkconfig lo genera idf.py a partir de sdkconfig.defaults. Versionarlo traeria
# conflictos en cada cambio de menuconfig y ataria el proyecto a la version de
# IDF de quien lo genero.
sdkconfig
sdkconfig.old

# Componentes que el gestor descarga solo.
managed_components/
dependencies.lock

