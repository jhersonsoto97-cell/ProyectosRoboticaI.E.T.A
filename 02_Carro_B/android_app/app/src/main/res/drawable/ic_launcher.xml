<?xml version="1.0" encoding="utf-8"?>
<!--
  Carro visto desde arriba, en la misma clave visual que el simulador: chasis con
  contorno cian, ruedas marcadas y flecha de rumbo. Se prefiere sobre el rune Bluetooth
  porque el icono debe decir que es esta app y no cualquier terminal Bluetooth.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0B1224" />

    <!-- Rejilla tenue, el mismo fondo cuadriculado del simulador. -->
    <path
        android:pathData="M27,0v108 M54,0v108 M81,0v108 M0,27h108 M0,54h108 M0,81h108"
        android:strokeColor="#16243F"
        android:strokeWidth="1" />

    <!-- Halo bajo el chasis. -->
    <path
        android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0"
        android:fillColor="#0F2A3D" />

    <!-- Ruedas izquierda y derecha. -->
    <path
        android:pathData="M28,36h10v36h-10z"
        android:fillColor="#2979FF" />
    <path
        android:pathData="M70,36h10v36h-10z"
        android:fillColor="#2979FF" />

    <!-- Chasis. -->
    <path
        android:pathData="M36,32h36a4,4 0,0 1,4 4v36a4,4 0,0 1,-4 4h-36a4,4 0,0 1,-4 -4v-36a4,4 0,0 1,4 -4z"
        android:fillColor="#101C33"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3" />

    <!-- Flecha de rumbo hacia adelante. -->
    <path
        android:pathData="M54,40l9,12h-18z"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M54,54v14"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
