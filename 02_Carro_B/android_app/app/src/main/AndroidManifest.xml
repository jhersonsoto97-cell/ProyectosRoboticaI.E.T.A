<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 y anteriores: los permisos Bluetooth clasicos son de instalacion. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Android 12 y superiores: permisos en tiempo de ejecucion para descubrir
         dispositivos y para abrir el socket SPP. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Hasta Android 11 el descubrimiento Bluetooth exige permiso de ubicacion, porque
         la lista de dispositivos cercanos permite inferir donde esta el usuario.

         El tope llega hasta la 32 y no hasta la 30 por el WiFi: unirse a la red de un
         carro con WifiNetworkSpecifier tambien pide ubicacion en Android 10, 11 y 12,
         por el mismo motivo. Desde la 13 ese permiso lo reemplaza NEARBY_WIFI_DEVICES. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Android 13 y superiores. Sin este permiso el sistema descarta en silencio el
         pedido de unirse a la red del carro: no lanza excepcion, simplemente nunca
         responde, que es exactamente como se veia el problema desde afuera.

         neverForLocation deja explicito que la app no deduce ubicacion a partir de las
         redes cercanas, y asi el sistema no exige ademas el permiso de ubicacion. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Solo para el transporte TCP contra el simulador del PC. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Para unirse a la red que levanta el carro y, sobre todo, para atar los sockets a
        ella. Sin CHANGE_NETWORK_STATE el sistema rechaza el pedido de red y el telefono
        sigue mandando todo por datos moviles aunque figure conectado al carro.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- required=false: el emulador no tiene radio Bluetooth y aun asi debe poder
         instalar la app para probar la interfaz contra el simulador. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartCar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.SmartCar.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
